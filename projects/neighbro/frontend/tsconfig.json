{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": [
      "es2024",
      "dom",
      "dom.iterable"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "target": "es2024",
    "types": [
      "vite/client"
    ],
    "useDefineForClassFields": true
  },
  "extends": "../tsconfig.json",
  "include": [
    "src",
    "vite.config.ts"
  ],
  "resolveJsonModule": true
}
