{
  "name": "wikiparallel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-only tool that returns Wikipedia articles from unrelated Fields describing the same underlying problem.",
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "serve": "python3 -m http.server 8000",
    "build": "node build/build.mjs",
    "build:list": "node build/build.mjs list",
    "embed:selfcheck": "node build/embed-selfcheck.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1"
  }
}
